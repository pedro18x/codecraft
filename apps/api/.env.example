# Server
NODE_ENV=development
PORT=3000

# Database (local Docker or remote)
DATABASE_URL=postgresql://codecraft:codecraft@localhost:5433/codecraft

# JWT Secrets (change in production!)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — add http://localhost:3001 when running the Next.js frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3001
AUTH_COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_COOKIE_NAME=csrf_token
ALLOW_BEARER_AUTH_FALLBACK=true
CSP_REPORT_ONLY=true

# Dedicated executor service (recommended for production)
# NOTE: Use port 3002+ when Next.js frontend occupies port 3001
EXECUTOR_URL=http://localhost:3002
EXECUTOR_SERVICE_TOKEN=dev-executor-service-token
EXECUTOR_ALLOWED_IPS=
EXECUTOR_MAX_CONCURRENCY=2
EXECUTOR_MAX_QUEUE=40

# Code execution limits
EXECUTOR_TIMEOUT_MS=5000
EXECUTOR_MEMORY_LIMIT_MB=128
